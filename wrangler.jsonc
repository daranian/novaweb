{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaweb",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1784b517-a80f-4840-89f4-e489d0a235a9","database_name": "web-app" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "221f6017131042c2b577f5f88884146d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
